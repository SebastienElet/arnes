{
  "name": "@sebastienelet/arnes",
  "version": "0.0.3",
  "description": "Read-only coding-agent configuration verification and isolated export",
  "type": "module",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienElet/arnes.git"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "bin": {
    "arnes": "bin/arnes.mjs"
  },
  "files": [
    "bin",
    "src",
    "tests",
    "examples",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "LICENSE",
    "NOTICE",
    "scripts",
    "packages/*/package.json",
    "bun.lock"
  ],
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@sebastienelet/arnes-darwin-arm64": "0.0.3",
    "@sebastienelet/arnes-linux-x64-gnu": "0.0.3"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "test": "cargo test --locked && bun test tests/launcher.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
